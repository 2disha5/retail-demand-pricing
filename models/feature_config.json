{
    "features": [
        "item_id",
        "store_id",
        "store_format",
        "city",
        "division",
        "days_since_previous",
        "lag_1",
        "lag_7",
        "lag_28",
        "rolling_7",
        "rolling_28",
        "rolling_7_count",
        "rolling_28_count",
        "day_of_week",
        "day_of_month",
        "month",
        "year",
        "is_weekend",
        "price_lag_1",
        "price_change"
